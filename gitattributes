# Normalize line endings so Windows checkouts don't produce whole-file diffs.
* text=auto eol=lf

# Shell scripts must stay LF even on Windows.
*.sh            text eol=lf
*.bash          text eol=lf

# Windows-only scripts must stay CRLF.
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Explicit binaries — never diff, never normalize.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.ico           binary
*.pdf           binary
*.zip           binary
*.gz            binary
*.woff          binary
*.woff2         binary
*.ttf           binary
*.otf           binary
*.mp4           binary
*.mp3           binary

# Lockfiles: keep them out of diff noise and out of language stats.
package-lock.json   -diff linguist-generated=true
yarn.lock           -diff linguist-generated=true
pnpm-lock.yaml      -diff linguist-generated=true
poetry.lock         -diff linguist-generated=true
Cargo.lock          -diff linguist-generated=true

# Don't ship repo meta in release tarballs.
.gitattributes      export-ignore
.gitignore          export-ignore
.editorconfig       export-ignore
.github/            export-ignore
