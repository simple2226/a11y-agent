# EditorConfig — https://editorconfig.org
# Keeps whitespace and line endings consistent across editors.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,rs,go}]
indent_size = 4

[*.{md,markdown}]
# Markdown uses trailing double-space for hard line breaks.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{yml,yaml,json,jsonc}]
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf
